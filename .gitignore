# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing & Coverage
/coverage
/.nyc_output

# Next.js Build Output
/.next/
/out/
/build
/dist

# Production Artifacts
*.tsbuildinfo
next-env.d.ts

# Sensitive Environment Variables (NEVER commit secrets, MongoDB URIs or API keys)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local File Database & Temp Storage
/data/*.json
!/data/.gitkeep

# Uploaded Judgment PDFs (Keep folder structure, ignore uploaded binary files)
/public/uploads/*
!/public/uploads/.gitkeep

# Logs & Debuggers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor & IDE Directories
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp

# Temporary Scratch Files & Archives
*.tmp
*.temp
*.bak
*.log
*.zip
*.tar.gz
