# Environment Variables for Legal Digest
# Replace with your actual credentials

# xAI Grok API Key (OpenAI-compatible)
GROK_API_KEY=xai-your-api-key-here
GROK_MODEL=grok-2-latest
# Grok endpoint defaults to https://api.x.ai/v1
GROK_API_BASE=https://api.x.ai/v1

# MongoDB Connection String (Atlas or Local)
# If empty or connection fails, the app uses an embedded resilient local storage
MONGODB_URI=mongodb://localhost:27017/legal_digest

# Authentication Secret
JWT_SECRET=super-secure-legal-digest-secret-key-32chars-min

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
